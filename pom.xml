<!--
  ~ ~~~~[ NOTE ON JAVADOC GENERATION ]~~~~
  ~
  ~ Javadoc generation has been made part of the standard (default) build.
  ~ To skip their generation, set the maven runtime variable `skip_docs` to `true`,
  ~ for example by running Maven like this:
  ~
  ~     mvn -Dskip_docs=true
  ~
  ~ If `skip_docs` is set to `false` or is found to be undefined, the Javadoc will be generated
  ~ every time Maven executes the default goal(s).
-->

<!--
  ~ ~~~~[ NOTE ON SELF-EXPIRATION ]~~~~
  ~
  ~ In order to force server admins not to linger too long on potentially buggy or dangerous DEV builds,
  ~ such builds may be built with
  ~
  ~     mvn -P expiration
  ~
  ~ in order to include the file located at:
  ~
  ~     src/main/resources/builtdate.yml
  ~
  ~ If such a file is included, it will contain the compilation date as provided by Maven. Should the current
  ~ date exceed this build date by a certain predefined lifetime (ie. 1 month) the plugin will refuse to load.
  ~ The expiration profile should ONLY BE ENABLED for DEV BUILDS!
  ~ It MUST NOT be used with any other kind of build (STABLE, BETA...).
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.shanerx</groupId>
    <artifactId>tradeshop</artifactId>
    <version>2.6.2-DEV</version>
    <packaging>jar</packaging>
    <name>TradeShop</name>
    <url>https://tradeshop.github.io/</url>
    <description>A powerful trading plugin based on sign-chest shops.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH.mm.ss</maven.build.timestamp.format>
        <timeStamp>${maven.build.timestamp}</timeStamp>
        <pluginDir>org/shanerx/tradeshop</pluginDir>
        <resourceDir>src/main/resources</resourceDir>

        <!-- Profile variables  -->
        <expirationFile/> <!-- default value for non-DEV build -->
        <doClean/> <!-- default value for dirty build -->
        <skipDocs/> <!-- default value for including docs -->
        <commit/> <!-- default value for excluding commit -->
        <branch/> <!-- default value for excluding commit -->
        <fileTimeStamp/> <!-- default value for excluding commit -->
        <build/> <!-- default value for jenkins build number -->

        <!-- Changeable variables  -->
        <outputDir>target</outputDir>
    </properties>

    <profiles>
        <profile>
            <id>expiration</id> <!-- additional profile for DEV build -->
            <properties>
                <expirationFile>builddate.yml</expirationFile>
            </properties>
        </profile>
        <profile>
            <id>clean</id> <!-- additional profile for a Clean build -->
            <properties>
                <doClean>clean</doClean>
            </properties>
        </profile>
        <profile>
            <id>skipDocs</id> <!-- additional profile for a no javadocs in build -->
            <properties>
                <skipDocs>true</skipDocs>
            </properties>
        </profile>
        <profile>
            <id>includeTimeStamp</id> <!-- additional profile for a timestamped build -->
            <properties>
                <fileTimeStamp>-${timeStamp}</fileTimeStamp>
            </properties>
        </profile>
        <profile>
            <id>includeCommit</id> <!-- additional profile for a non-commit named build -->
            <properties>
                <!--suppress UnresolvedMavenProperty -->
                <commit>-${commit_num}
                </commit> <!-- `-Dcommit_num=###` is required for the commit number to appear in the file name -->
            </properties>
        </profile>
        <profile>
            <id>includeBranch</id> <!-- additional profile for a non-commit named build -->
            <properties>
                <!--suppress UnresolvedMavenProperty -->
                <branch>-${branch_name}
                </branch> <!-- `-Dbranch_name=###` is required for the branch name to appear in the file name -->
            </properties>
        </profile>
        <profile>
            <id>includeBuild</id> <!-- additional profile for a non-commit named build -->
            <properties>
                <!--suppress UnresolvedMavenProperty -->
                <branch>-${build_num}
                </branch> <!-- `-Dbuild_num=###` is required for the branch name to appear in the file name -->
            </properties>
        </profile>
    </profiles>

    <build>
        <defaultGoal>${doClean} install</defaultGoal>
        <finalName>${project.name}-${project.version}${branch}${commit}${fileTimeStamp}${build}</finalName>

        <directory>${outputDir}/PreShade/</directory>

        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <targetPath>.</targetPath>
                <filtering>true</filtering>
                <directory>${basedir}/${resourceDir}</directory>
                <includes>
                    <include>plugin.yml</include>
                    <include>${expirationFile}</include>
                </includes>
            </resource>
            <resource>
                <targetPath>./Lang</targetPath>
                <filtering>false</filtering>
                <directory>${basedir}/${resourceDir}/Lang</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <!-- Main sources stay on 1.8; that is a separate decision from
                         testing. MockBukkit and the paper-api it pulls in are compiled
                         for 21, so the test sources have to be too. -->
                    <testRelease>21</testRelease>
                    <!-- JDK 23+ stopped running annotation processors found on the
                         classpath by default, which silently skips Lombok and drops
                         every generated accessor. <proc>full</proc> forces annotation
                         processing regardless of JDK; valid since JDK 21, so it raises
                         no floor. -->
                    <proc>full</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- One JVM for the whole suite. The harness mocks Bukkit once per
                         JVM rather than per class, because the plugin caches its own
                         instance in static finals that a second mock/unmock cycle
                         cannot refresh. See MockBukkitEnvironment. -->
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <systemPropertyVariables>
                        <!-- bStats refuses to start unless the shade plugin has
                             relocated it, which has not happened when tests run
                             against target/classes. -->
                        <bstats.relocatecheck>false</bstats.relocatecheck>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <!-- A skipped test must break the build.

                             MockBukkit reports API it has not implemented by throwing
                             UnimplementedOperationException, which extends JUnit's
                             TestAbortedException, so surefire files it as "Tests run: 1,
                             Skipped: 1" and exits 0. A green build over a suite that
                             tested nothing is worse than no suite, so every <skipped>
                             element in the reports fails the build here. @Disabled and
                             failed assumptions are caught by the same net, deliberately:
                             if a test is not to run, delete it. -->
                        <id>fail-on-skipped-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${maven.test.skip}</skip>
                            <target>
                                <fail message="Skipped tests are failures here. See the surefire reports in ${project.build.directory}/surefire-reports for which, and why.">
                                    <condition>
                                        <resourcecount when="greater" count="0">
                                            <fileset dir="${project.build.directory}/surefire-reports"
                                                     includes="TEST-*.xml" erroronmissingdir="false">
                                                <containsregexp expression="&lt;skipped"/>
                                            </fileset>
                                        </resourcecount>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <minimizeJar>true</minimizeJar>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <outputFile>${outputDir}/server/plugins/${project.build.finalName}.jar</outputFile>
                    <artifactSet>
                        <includes>
                            <include>org.bstats:*</include>
                            <include>de.themoep:*</include>
                            <include>com.bergerkiller.bukkit:*</include>
                            <include>com.github.simplix-softworks:*</include>
                            <include>de.leonhart:*</include>
                        </includes>
                    </artifactSet>
                    <relocations>
                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>${project.groupId}.${project.artifactId}.bstats</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>de.themoep</pattern>
                            <shadedPattern>${project.groupId}.${project.artifactId}</shadedPattern>
                        </relocation>
                    </relocations>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/**</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.coderplus.maven.plugins</groupId>
                <artifactId>copy-rename-maven-plugin</artifactId>
                <version>1.0</version>
                <configuration>
                    <fileSets>
                        <fileSet>
                            <sourceFile>${outputDir}/server/plugins/${project.build.finalName}.jar</sourceFile>
                            <destinationFile>${outputDir}/${project.build.finalName}.jar</destinationFile>
                        </fileSet>
                    </fileSets>
                </configuration>
                <executions>
                    <execution>
                        <id>copy</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <name>${project.build.finalName}</name>
                    <failOnError>false</failOnError>
                    <jarOutputDirectory>${outputDir}</jarOutputDirectory>
                    <!--suppress UnresolvedMavenProperty -->
                    <skip>${skipDocs}</skip>
                    <sourceFileExcludes>
                        <exclude>${pluginDir}/TradeShop.java</exclude>
                        <exclude>${pluginDir}/commands/**</exclude>
                        <exclude>${pluginDir}/shop/listeners/**</exclude>
                        <exclude>${pluginDir}/utils/versionmanagement/**</exclude>
                        <exclude>${pluginDir}/player/JoinEventListener.java</exclude>
                    </sourceFileExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>

        <repository>
            <id>MG-Dev Jenkins CI Maven Repository</id>
            <url>https://ci.mg-dev.eu/plugin/repository/everything</url>
        </repository>

        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>

        <repository>
            <id>CodeMC</id>
            <url>https://repo.codemc.org/repository/maven-public</url>
        </repository>

        <repository>
            <id>minebench-repo</id>
            <url>https://repo.minebench.de/</url>
        </repository>

        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- paper-api is declared FIRST, and the order is load-bearing.
             Both jars ship org.bukkit.*, and only the first copy on the
             classpath is ever used. Paper's is Spigot's with patches on top,
             so putting Spigot first silently strips those patches: anything
             reaching a Paper-added member of a shared class dies at run time
             with NoSuchMethodError, invisibly to the compiler. Measured here —
             Spigot first fails on SimpleCommandMap.<init>(Server, Map).

             Both are pinned to the same Minecraft version on purpose. When
             they disagreed (spigot 1.21.1, paper 1.20.1) the mismatch was
             equally invisible to a build and equally fatal at run time. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>de.themoep</groupId>
            <artifactId>inventorygui</artifactId>
            <version>1.6-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.4.1</version>
            <type>maven-plugin</type>
        </dependency>

        <dependency>
            <groupId>se.eris</groupId>
            <artifactId>notnull-instrumenter-maven-plugin</artifactId>
            <version>1.1.1</version>
        </dependency>

        <!-- 2.0.2 is the current GA, and it is also what the plugin already meets
             at run time: ci/integration.sh installs BKCommonLib 2.0.2-SNAPSHOT
             build 2031 on the server it boots. Compiling against 1.20.2-v1 while
             running against 2.0.x was a mismatch a build could not see - the same
             shape of defect the paper/spigot ordering comment below is about.
             The one type TradeShop touches, JsonSerializer, has identical
             signatures in both, so nothing in src/ changes. -->
        <dependency>
            <groupId>com.bergerkiller.bukkit</groupId>
            <artifactId>BKCommonLib</artifactId>
            <version>2.0.2</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.github.simplix-softworks</groupId>
            <artifactId>SimplixStorage</artifactId>
            <version>3.2.7</version>
            <scope>compile</scope>
        </dependency>

        <!-- MockBukkit's v1.21 line is built against the same Minecraft version as the
             spigot-api above, which is the one that has to match: both jars ship
             org.bukkit.*, and spigot-api is declared first so it is what the plugin
             actually compiles and runs against. -->
        <dependency>
            <groupId>com.github.seeseemelk</groupId>
            <artifactId>MockBukkit-v1.21</artifactId>
            <version>3.133.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>central</id>
            <name>KOP-Artifactory-releases</name>
            <url>https://repo.killerofpie.com/artifactory/${project.name}</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>KOP-Artifactory-snapshots</name>
            <url>https://repo.killerofpie.com/artifactory/${project.name}</url>
        </snapshotRepository>
    </distributionManagement>
</project>
